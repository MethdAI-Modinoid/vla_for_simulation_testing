<mujoco model="g1_43dof pnp_cube_basket scene">
  <include file="g1_29dof_with_hand.xml"/>
  <!-- Note that the hand model in g1_29dof_with_hand.xml is not stable for simulation. -->

  <statistic center="0 0 0.5" extent="2.0"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="-130" elevation="-20"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
    <material name="mat_cube" rgba="0.85 0.12 0.12 1"/>
    <material name="mat_basket" rgba="0.12 0.70 0.18 1"/>
    <material name="mat_table" rgba="0.55 0.40 0.26 1"/>
  </asset>

  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>
    <!-- Site -->
    <site name="com_marker" pos="0.1 0 0" size="0.05" rgba="1 0 0 1" type="sphere"/>

    <!-- ================ Single-object pick and place ================ -->
    <!-- Robot faces +x, so the table and objects are placed in front (+x). The -->
    <!-- table geometry is copied unchanged from scene_43dof.xml, where it is -->
    <!-- already tuned for the robot's arm reach. -->

    <!-- Table: static. Top surface at z = 0.76 m. -->
    <body name="table" pos="0.41 0 0">
      <geom name="table_top" type="box" size="0.35 0.45 0.02" pos="0 0 0.74" material="mat_table"/>
      <geom name="table_leg_fl" type="box" size="0.02 0.02 0.36" pos="0.30 0.40 0.36" material="mat_table"/>
      <geom name="table_leg_fr" type="box" size="0.02 0.02 0.36" pos="0.30 -0.40 0.36" material="mat_table"/>
      <geom name="table_leg_bl" type="box" size="0.02 0.02 0.36" pos="-0.30 0.40 0.36" material="mat_table"/>
      <geom name="table_leg_br" type="box" size="0.02 0.02 0.36" pos="-0.30 -0.40 0.36" material="mat_table"/>
    </body>

    <!-- Basket: fixed open-top container sitting on the table top (z = 0.76), in -->
    <!-- the back slot so the cube in front can be picked and dropped into it. -->
    <body name="basket" pos="0.33 0 0.76">
      <geom name="basket_floor" type="box" size="0.06 0.06 0.005" pos="0 0 0.005" material="mat_basket"/>
      <geom name="basket_wpx" type="box" size="0.005 0.06 0.03" pos="0.055 0 0.035" material="mat_basket"/>
      <geom name="basket_wnx" type="box" size="0.005 0.06 0.03" pos="-0.055 0 0.035" material="mat_basket"/>
      <geom name="basket_wpy" type="box" size="0.06 0.005 0.03" pos="0 0.055 0.035" material="mat_basket"/>
      <geom name="basket_wny" type="box" size="0.06 0.005 0.03" pos="0 -0.055 0.035" material="mat_basket"/>
    </body>

    <!-- Cube: 7 cm, physical (freejoint), resting on the table (z = 0.795) in the -->
    <!-- front slot. Fixed start position: the shuffling in randomize_cubes only -->
    <!-- applies to the three-cube sorting scene and no-ops here. -->
    <body name="cube" pos="0.2 0 0.795">
      <freejoint name="cube_free"/>
      <geom name="cube_geom" type="box" size="0.035 0.035 0.035" material="mat_cube"/>
    </body>
  </worldbody>

  <default>
    <geom friction="1.0"/>
  </default>
</mujoco>
